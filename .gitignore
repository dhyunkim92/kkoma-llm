__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
dist/
.venv/
venv/
.env

# artifacts and data are large and reproducible; the scripts makedirs() what
# they need, so no directory placeholders are required.
# root-anchored so kkoma/data/ (source code) is not swept up
/artifacts/*
/data/
/wandb/
*.pt
*.bin

# the tokenizer is the exception. Every phase assumes this exact vocab, and
# retraining BPE from a fresh sample will not reproduce the same merges, so the
# 3.3MB is worth keeping. Data manifests live under /data/ and stay ignored.
!/artifacts/tokenizer/

.pytest_cache/
.ipynb_checkpoints/